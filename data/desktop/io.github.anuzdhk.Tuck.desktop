[Desktop Entry]
Type=Application
Name=Tuck
GenericName=File Manager
Comment=Browse, organise and find your files
Exec=tuck %U
Icon=io.github.anuzdhk.Tuck
Terminal=false
StartupNotify=true
StartupWMClass=io.github.anuzdhk.Tuck
Categories=GTK;System;FileTools;FileManager;
Keywords=folder;files;explorer;finder;browse;manager;archive;
MimeType=inode/directory;application/x-gnome-saved-search;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=tuck --new-window
